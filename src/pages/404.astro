---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getBlogPosts } from "../lib/posts";

// Built to /404.html. Cloudflare Pages serves this file with a real 404 status
// for any unmatched URL instead of falling back to the homepage with a 200,
// which Google was treating as soft-404s canonicalized to "/".
const recent = (await getBlogPosts())
    .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime())
    .slice(0, 6);
---

<Layout title="Page not found | BatteryTrail" description="The page you are looking for does not exist." noindex>
    <Header />
    <main class="flex-grow w-full max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white mb-4">Page not found</h1>
        <p class="text-slate-400 mb-8">
            That page doesn't exist or has moved. Try one of our latest guides or
            <a class="text-primary hover:underline" href="/archive/">browse all posts</a>.
        </p>
        <ul class="space-y-3">
            {recent.map((post) => (
                <li>
                    <a class="text-primary hover:underline" href={`/posts/${post.data.slug}/`}>{post.data.title}</a>
                </li>
            ))}
        </ul>
    </main>
    <Footer />
</Layout>
