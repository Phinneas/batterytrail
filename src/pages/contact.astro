---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
    title="Contact | BatteryTrail"
    description="Get in touch with BatteryTrail for questions, corrections, partnerships, or story ideas."
>
    <Header />

    <main class="flex-grow w-full max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="mb-10 border-b border-[#224249] pb-8">
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-[1.15]">
                Contact
            </h1>
            <p class="mt-4 text-lg text-text-muted max-w-2xl">
                Questions, corrections, or story ideas? We'd love to hear from you.
            </p>
        </div>

        <div class="prose prose-lg dark:prose-invert max-w-none prose-a:text-primary prose-a:no-underline hover:prose-a:underline">
            <p>
                The fastest way to reach us is by email. We read every message and
                aim to respond within a few business days.
            </p>
        </div>

        <a
            href="mailto:chesterbeard@salishseaconsulting.com"
            class="mt-6 inline-flex items-center gap-3 rounded-xl bg-primary/10 border border-primary/30 px-6 py-4 text-primary hover:bg-primary/20 transition-colors"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span class="font-semibold">chesterbeard@salishseaconsulting.com</span>
        </a>

        <div class="prose prose-lg dark:prose-invert max-w-none prose-a:text-primary prose-a:no-underline hover:prose-a:underline mt-8">
            <h2>What to include</h2>
            <ul>
                <li>
                    <strong>Corrections:</strong> tell us the page URL and what's wrong.
                </li>
                <li>
                    <strong>Guide requests:</strong> a topic you'd like us to cover.
                </li>
                <li>
                    <strong>Partnerships:</strong> details about your product or brand.
                </li>
            </ul>
        </div>
    </main>

    <Footer />
</Layout>
